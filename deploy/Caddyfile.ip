# ============================================================
#  IP 阶段的 Caddy 配置（还没有域名，或者域名还没备案）
# ------------------------------------------------------------
#  怎么启用：
#    在 deploy/.env 里加一行        CADDYFILE=Caddyfile.ip
#    然后  docker compose up -d caddy
#
#  为什么只能用 http：
#    Let's Encrypt 只给**域名**签证书，不给纯 IP 地址签。
#    所以没有域名之前，只能以 http 提供服务，浏览器会标「不安全」。
#    这是过渡状态 —— 域名备案通过后换回 Caddyfile 就自动有 HTTPS 了。
#
#  ⚠️ 这个模式只服务静态博客，不跑评论和统计。
#     那两个服务需要域名才体面（Waline 前端要填绝对地址、
#     Umami 挂子路径还得改 BASE_PATH），留到域名阶段再上。
# ============================================================

{
	admin off
	# 关键：关掉自动 HTTPS。
	# 不关的话 Caddy 会试图给 IP 申请证书，失败后不断重试，
	# 日志被刷满、启动也会明显变慢。
	auto_https off
}

:80 {
	root * /srv/blog
	encode zstd gzip
	file_server

	# Hugo 生成的是 /404.html，用它兜底
	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# 自托管的大体积资源：一年不过期
	header /katex/* Cache-Control "public, max-age=31536000, immutable"
	header /mermaid/* Cache-Control "public, max-age=31536000, immutable"
	header /photoswipe/* Cache-Control "public, max-age=31536000, immutable"

	# HTML 不缓存，保证发完文刷新就能看到
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# 过渡期的站点：明确告诉搜索引擎别收录，免得将来换成域名后判重
	header X-Robots-Tag "noindex, nofollow"
}
