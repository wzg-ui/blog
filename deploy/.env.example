# ============================================================
#  复制成 .env 后逐项填写。
#  ⚠️ .env 已被 .gitignore 忽略，千万不要提交到仓库里。
#
#    cp .env.example .env
#    vi .env
#
#  生成随机密码（在服务器上跑）：
#    openssl rand -base64 24
# ============================================================

# ---- 你的域名（不带 https://，不带末尾斜杠）----
# 例：blzrw.com
BLOG_DOMAIN=example.com

# ---- 站点名（会显示在评论框上方）----
SITE_NAME=BLZRW

# ---- 管理员邮箱：用这个邮箱注册的评论账号自动成为管理员 ----
ADMIN_EMAIL=you@example.com

# ---- PostgreSQL ----
PG_USER=blog
# 【必填】改成自己生成的强密码
PG_PASSWORD=CHANGE_ME_strong_password

# 两个库名保持默认即可，初始化脚本会自动创建
WALINE_DB=waline
UMAMI_DB=umami

# ---- Umami 会话加密串 ----
# 【必填】随便一串长随机字符，比如 openssl rand -hex 32 的输出
# 注意：这个值一旦设定就不要改，改了所有人登录态失效
UMAMI_APP_SECRET=CHANGE_ME_random_hex_32
