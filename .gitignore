# ---------- Hugo 构建产物 ----------
/public/
/resources/_gen/
.hugo_build.lock

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---------- Obsidian ----------
# 整个配置目录不入库：插件体积不小，且换机器重装一遍很快。
# 需要安装哪些插件写在 README 里。
.obsidian/

# ---------- 临时文件 ----------
*.log
*.tmp

# ---------- WorkBuddy 本机状态 ----------
# .workbuddy/ 下是本机资料：memory/（项目笔记）、shots/（验收截图）、
# trash/（删改前的备份）。都是这台机器上的状态，不进仓库。
# ⚠️ 若想给这些笔记做异地备份，用私有仓库，别塞进这个公开站点的仓库。
.workbuddy/

# ---------- 发布标记 ----------
# WorkBuddy「发布为应用」时在工作区根目录生成的 app 标记文件，属于本机状态，
# 换了机器没意义，不该进仓库（真实内容只有 appId 和本地目录）
.wbapp_*.genie

# ---------- 服务器部署 ----------
# .env 里有数据库密码和会话密钥，绝对不能提交
deploy/.env
# 若走「路线二」把构建产物挂给 Caddy，这个目录是 public/ 的副本，不需要入库
deploy/site/

# ---------- 本地工具与说明文档 ----------
# tools/ 放的是 Hugo 运行环境（63 MB 的二进制），各人机器上版本可能不同，
# 而且完全可以用 scoop / brew / 官方压缩包重新装一份，不该进仓库。
/tools/
# docs/ 是写给自己看的执行清单和部署手册，属于本机资料，不随站点一起发布
/docs/
